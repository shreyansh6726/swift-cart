{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://your-app-admin.vercel.app/admin/"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://your-app-admin.vercel.app/admin/$1"
    },
    {
      "source": "/retailer",
      "destination": "https://your-app-retailer.vercel.app/retailer/"
    },
    {
      "source": "/retailer/(.*)",
      "destination": "https://your-app-retailer.vercel.app/retailer/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}