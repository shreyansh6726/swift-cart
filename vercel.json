{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "customer": {
      "root": "customer",
      "framework": "vite"
    },
    "retailer": {
      "root": "retailer",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "admin"
      }
    }
  ]
}