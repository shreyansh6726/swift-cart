{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin": {
      "root": "admin",
      "framework": "vite"
    },
    "customer": {
      "root": "customer",
      "framework": "vite"
    },
    "retailer": {
      "root": "retailer",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/retailer",
      "destination": {
        "service": "retailer"
      }
    },
    {
      "source": "/retailer/(.*)",
      "destination": {
        "service": "retailer"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "customer"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "customer"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "customer"
      }
    }
  ]
}